  "test_scenarios": [
    {
      "name": "click_dialog_buttons",
      "description": "Click OK and Cancel buttons in small dialog",
      "window_id": "small_dialog_1",
      "target_elements": ["OK", "Cancel"]
    },
    {
      "name": "click_menu_items",
      "description": "Click menu items in main window",
      "window_id": "main_window_1",
      "target_elements": ["File", "Edit"]
    },
    {
      "name": "close_notification",
      "description": "Click close button on notification",
      "window_id": "small_notification",
      "target_elements": ["X"]
    },
    {
      "name": "interact_with_settings",
      "description": "Interact with settings panel",
      "window_id": "settings_panel",
      "target_elements": ["Enable feature", "Apply", "Cancel"]
    }
