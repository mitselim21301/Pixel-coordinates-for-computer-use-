# MCP Accurate Click Server - Environment Variables
# ===================================================
# Copy this file to .env and customize for your environment
# Environment variables override config.yaml settings

# OCR Configuration
# -----------------

# OCR language (default: en)
# Supported: en, ch, fr, de, es, pt, ru, ar, ja, ko, etc.
MCP_OCR_LANGUAGE=en

# Enable GPU acceleration (true/false)
# Requires CUDA-enabled GPU and paddlepaddle-gpu
# Provides 3-10x speedup for OCR operations
MCP_OCR_USE_GPU=false

# OCR confidence threshold (0.0-1.0)
# Lower = more detections, less reliable
# Higher = fewer detections, more accurate
MCP_OCR_CONFIDENCE_THRESHOLD=0.6


# Calibration Configuration
# --------------------------

# Number of calibration points (minimum 30, recommended 100)
# More points = higher accuracy but slower calibration
# Research shows:
#   30 points  -> 99.8% accuracy
#   100 points -> 99.95%+ accuracy
MCP_CALIBRATION_POINTS=100

# Enable automatic recalibration (true/false)
# Automatically recalibrate when accuracy drops
MCP_AUTO_RECALIBRATE=true


# Click Configuration
# -------------------

# Mouse button to use for clicks
# Options: left, right, middle
MCP_CLICK_BUTTON=left

# Validate click location after clicking (true/false)
# Recommended: true for production
MCP_VALIDATE_CLICK=true


# Performance Configuration
# --------------------------

# Enable result caching (true/false)
# Caching improves performance for repeated operations
MCP_CACHE_ENABLED=true

# Use GPU for OCR (alias for MCP_OCR_USE_GPU)
MCP_USE_GPU=false


# Logging Configuration
# ----------------------

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG = verbose, useful for troubleshooting
# INFO = normal operation
# WARNING = only warnings and errors
MCP_LOG_LEVEL=INFO

# Log file path (uses ~ for home directory)
MCP_LOG_FILE=~/.mcp-accurate-click/logs/server.log


# Storage Configuration
# ----------------------

# Base directory for data storage
# Stores calibration data, state, logs, and cache
MCP_DATA_DIR=~/.mcp-accurate-click

# Calibration data file
MCP_CALIBRATION_FILE=~/.mcp-accurate-click/calibration.npz

# State file
MCP_STATE_FILE=~/.mcp-accurate-click/state.json


# Development & Testing
# ----------------------

# Enable debug mode (true/false)
# Provides additional logging and validation
MCP_DEBUG=false

# Force recalibration on startup (true/false)
# Useful for testing calibration process
MCP_FORCE_RECALIBRATE=false

# Save debug screenshots (true/false)
# Save screenshots of OCR results for debugging
MCP_SAVE_DEBUG_SCREENSHOTS=false

# Debug screenshot directory
MCP_DEBUG_SCREENSHOT_DIR=~/.mcp-accurate-click/debug


# Advanced Settings
# -----------------

# DPI awareness mode (system, per_monitor_v1, per_monitor_v2)
# per_monitor_v2 recommended for Windows 10 1703+
MCP_DPI_MODE=per_monitor_v2

# Maximum cache size (number of items)
MCP_MAX_CACHE_SIZE=1000

# Cache TTL in seconds
MCP_CACHE_TTL=300

# Number of worker threads for parallel processing
MCP_MAX_WORKERS=4


# Security & Safety
# -----------------

# Require confirmation before clicks (true/false)
# Set to true for initial testing
MCP_REQUIRE_CONFIRMATION=false

# Maximum click rate (clicks per second)
# Rate limiting for safety
MCP_MAX_CLICK_RATE=10

# Enable click exclusion zones (true/false)
MCP_ENABLE_EXCLUSION_ZONES=false


# Model Configuration
# -------------------

# PaddleOCR model directory (optional)
# Leave empty to use default ~/.paddleocr
# MCP_PADDLEOCR_MODEL_DIR=/path/to/models

# Custom OCR model URLs (advanced)
# Uncomment to use custom models
# MCP_OCR_DET_MODEL_URL=https://...
# MCP_OCR_REC_MODEL_URL=https://...
# MCP_OCR_CLS_MODEL_URL=https://...


# Experimental Features
# ---------------------
# WARNING: These features are experimental and may be unstable

# Use deep learning refinement (true/false)
MCP_EXPERIMENTAL_DL_REFINEMENT=false

# Enable predictive caching (true/false)
MCP_EXPERIMENTAL_PREDICTIVE_CACHE=false

# Enable adaptive calibration (true/false)
MCP_EXPERIMENTAL_ADAPTIVE_CALIBRATION=false


# Example Production Configuration
# ---------------------------------
# Uncomment and customize for production use:

# Production with GPU acceleration
# MCP_OCR_USE_GPU=true
# MCP_CALIBRATION_POINTS=100
# MCP_AUTO_RECALIBRATE=true
# MCP_VALIDATE_CLICK=true
# MCP_LOG_LEVEL=WARNING
# MCP_CACHE_ENABLED=true

# Development/Testing
# MCP_OCR_USE_GPU=false
# MCP_CALIBRATION_POINTS=30
# MCP_LOG_LEVEL=DEBUG
# MCP_SAVE_DEBUG_SCREENSHOTS=true
# MCP_REQUIRE_CONFIRMATION=true
